# Clean Supabase project only.
# Do not use the Lovable/original database credentials here.
# Copy this file to .env.local and replace the placeholder values before running locally.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=SUA_ANON_PUBLIC_KEY

# OAuth Google fica desligado na copia limpa ate ser configurado no Supabase novo.
VITE_ENABLE_GOOGLE_AUTH=false

# Optional fallback names used by older server/dev code paths.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=SUA_ANON_PUBLIC_KEY

# Required only for server-side/admin operations.
SUPABASE_SERVICE_ROLE_KEY=SUA_SERVICE_ROLE_KEY

# Gemini API configuration (server only; never use a VITE_ prefix).
GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_MODEL=gemini-3.5-flash

# Google Calendar OAuth. Configure these as Supabase Edge Function secrets,
# never as VITE_ variables or browser-exposed values.
GOOGLE_OAUTH_CLIENT_ID=seu_client_id_google
GOOGLE_OAUTH_CLIENT_SECRET=seu_client_secret_google
# ID do único calendário corporativo compartilhado no Google Calendar.
GOOGLE_SHARED_CALENDAR_ID=seu_calendario_compartilhado@group.calendar.google.com
TASKFLOW_APP_URL=https://seu-dominio.com

# Supabase Edge Function secret. It must be the public address that receives
# invitations and is registered in Supabase Auth > URL Configuration.
INVITE_REDIRECT_URL=https://seu-dominio.com/auth?invite=1

# Configure all variables above in Vercel (Production, Preview and Development).
# Never use the VITE_ prefix for SUPABASE_SERVICE_ROLE_KEY or any AI provider key.
